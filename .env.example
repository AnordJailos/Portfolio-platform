# ============================================================================
# ENVIRONMENT VARIABLES — copy this file to `.env` and fill in real values.
# Full step-by-step instructions for every value below are in SETUP_GUIDE.docx
# Never commit the real `.env` file.
# ============================================================================

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler URL for DATABASE_URL (used at runtime)
# and the "Session"/direct URL for DIRECT_URL (used by Prisma migrations).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase (storage for images + shares the Postgres above) -------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # server-only, never expose to the client

# --- Auth (Auth.js / NextAuth v5) -------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000" # set to your production URL when deploying

# --- OpenAI (chat completions + embeddings) ---------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Resend (transactional email: booking confirmations, contact form) ------
# https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="You <you@yourdomain.com>"
EMAIL_TO_ADMIN="you@yourdomain.com" # where contact-form submissions are sent

# --- Google Calendar (booking availability + event creation) ----------------
# Google Cloud Console → APIs & Services → Credentials (OAuth 2.0 Client)
# Full walkthrough in SETUP_GUIDE.docx
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REFRESH_TOKEN="your-refresh-token" # obtained once via the OAuth playground/consent flow
GOOGLE_CALENDAR_ID="primary" # or a specific calendar ID

# --- PostHog (product analytics) --------------------------------------------
# https://posthog.com — Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Site / profile basics used across metadata and emails ------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Your Name"

# --- Admin bootstrap ----------------------------------------------------------
# Used one time by prisma/seed.ts to create your first admin user.
# Change the password immediately after first login.
ADMIN_SEED_EMAIL="you@yourdomain.com"
ADMIN_SEED_PASSWORD="change-me-immediately"
